{
  "name": "ironcalc-svelte",
  "version": "0.1.0",
  "description": "Svelte 5 port of the IronCalc spreadsheet widget",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/esotericbyte/SvelteIronCalc.git"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && npm run package",
    "package": "svelte-kit sync && svelte-package && publint",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "NOTICE",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    },
    "./xlsx": {
      "types": "./dist/xlsx.d.ts",
      "default": "./dist/xlsx.js"
    }
  },
  "dependencies": {
    "@ironcalc/wasm": "0.9.1"
  },
  "peerDependencies": {
    "@ironcalc/wasm-xlsx": "0.9.1",
    "@lucide/svelte": "^1.61.0",
    "@skeletonlabs/skeleton": "^5.0.1",
    "@skeletonlabs/skeleton-svelte": "^5.0.1",
    "svelte": "^5.57.0"
  },
  "peerDependenciesMeta": {
    "@ironcalc/wasm-xlsx": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ironcalc/wasm-xlsx": "0.9.1",
    "@lucide/svelte": "^1.61.0",
    "@skeletonlabs/skeleton": "^5.0.1",
    "@skeletonlabs/skeleton-svelte": "^5.0.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/package": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^22.20.5",
    "jsdom": "^28.1.0",
    "publint": "^0.3.25",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
